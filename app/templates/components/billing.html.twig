<section id="billing-view" class="dashboard" hidden>
    <p class="eyebrow">Operativos / Ventas registradas</p>
    <div class="page-heading"><div><h1>Facturación</h1><p class="muted">Retoma las ventas pendientes o imprime tus facturas.</p></div></div>
    <div class="catalog-panel">
        <div class="catalog-toolbar">
            <div class="catalog-label"><label for="billing-status">Estado</label><select id="billing-status"><option value="">Todos</option><option value="pending">Pendiente de pago</option><option value="paid">Facturada</option></select></div>
            <button id="billing-refresh" class="button-secondary button-small" type="button">Actualizar listado</button>
        </div>
        <div class="catalog-toolbar">
            <div class="products-filter-field"><label for="billing-number-filter">Número de factura</label><input id="billing-number-filter" name="number" type="search" maxlength="20" autocomplete="off" placeholder="Ejemplo: F-000123 o 123"></div>
            <div class="products-filter-field"><label for="billing-date-from">Desde</label><input id="billing-date-from" name="from" type="date" aria-describedby="billing-date-help"></div>
            <div class="products-filter-field"><label for="billing-date-to">Hasta</label><input id="billing-date-to" name="to" type="date" aria-describedby="billing-date-help"></div>
        </div>
        <p id="billing-date-help" class="catalog-state small-text">Fecha de creación de la factura. Incluye ambos días, en hora de Colombia.</p>
        <p id="billing-loading" class="catalog-state" role="status">Cargando registros…</p>
        <p id="billing-empty" class="catalog-state" hidden>No hay facturas que coincidan con los filtros.</p>
        <div id="billing-table-container" class="table-scroll" hidden>
            <table class="products-table"><caption class="sr-only">Ventas pendientes y facturadas</caption><thead><tr><th scope="col">Registro</th><th scope="col">Fecha</th><th scope="col">Estado</th><th scope="col" class="price-cell">Total</th><th scope="col" class="row-actions">Acciones</th></tr></thead><tbody id="billing-rows"></tbody></table>
        </div>
        <div id="billing-pagination" class="catalog-pagination" hidden><p id="billing-count" class="muted small-text"></p><nav class="pagination-buttons" aria-label="Páginas de facturación"><button id="billing-previous" class="button-secondary button-small" type="button">← Anterior</button><span id="billing-page-number" aria-live="polite"></span><button id="billing-next" class="button-secondary button-small" type="button">Siguiente →</button></nav></div>
    </div>
    <dialog id="billing-detail-dialog" class="app-dialog billing-dialog" aria-labelledby="billing-detail-title">
        <div class="dialog-heading"><div><p class="eyebrow">Contenido de la factura</p><h2 id="billing-detail-title"></h2></div><button id="billing-detail-close" class="dialog-close" type="button" aria-label="Cerrar contenido de la factura">×</button></div>
        <p id="billing-detail-status" class="muted"></p>
        <p id="billing-detail-date" class="muted"></p>
        <div class="table-scroll"><table class="products-table"><caption class="sr-only">Productos de la factura</caption><thead><tr><th scope="col">Producto</th><th scope="col">Cantidad</th><th scope="col" class="price-cell">Precio unitario</th><th scope="col" class="price-cell">Subtotal</th></tr></thead><tbody id="billing-detail-rows"></tbody></table></div>
        <div class="sale-total"><span>Total COP</span><strong id="billing-detail-total"></strong></div>
        <div id="billing-detail-payment" hidden>
            <p>Método de pago: <strong id="billing-detail-method"></strong></p>
            <p>Transferencia COP: <strong id="billing-detail-transfer"></strong></p>
            <div id="billing-detail-cash">
            <p>Dinero recibido COP: <strong id="billing-detail-received"></strong></p>
            <p>Cambio a devolver COP: <strong id="billing-detail-change"></strong></p>
            </div>
        </div>
        <div class="dialog-actions"><button id="billing-detail-done" class="button-secondary" type="button">Cerrar</button></div>
    </dialog>
    <dialog id="billing-dialog" class="app-dialog billing-dialog" aria-labelledby="billing-dialog-title">
        <div class="dialog-heading"><div><p class="eyebrow">Pendiente de pago</p><h2 id="billing-dialog-title">Editar registro</h2></div><button id="billing-close" class="dialog-close" type="button" aria-label="Cerrar edición">×</button></div>
        <p class="field-help">Puedes agregar o retirar productos y cambiar cantidades. Guarda los cambios antes de pagar.</p>
        <form id="billing-scan-form"><label for="billing-barcode">Código de barras</label><div class="scan-input-row"><input id="billing-barcode" maxlength="100" autocomplete="off" placeholder="Escanea o escribe el código" required><button class="button" type="submit">Agregar</button></div></form>
        <form id="billing-edit-form">
            <div class="table-scroll"><table class="products-table"><caption class="sr-only">Detalle del registro pendiente</caption><thead><tr><th scope="col">Producto</th><th scope="col">Cantidad</th><th scope="col" class="price-cell">Subtotal</th><th scope="col">Acción</th></tr></thead><tbody id="billing-edit-rows"></tbody></table></div>
            <div class="sale-total"><span>Total</span><strong id="billing-edit-total" aria-live="polite"></strong></div>
            <div class="dialog-actions"><button id="billing-cancel" class="button-secondary" type="button">Cancelar</button><button id="billing-save" class="button" type="submit">Guardar cambios</button></div>
        </form>
    </dialog>
</section>
