        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}La Licorería{% endblock %}</title>
        <link rel="stylesheet" href="/styles/app.css?v=20261110-miniaturas">
        {% block scripts %}<script type="module" src="/scripts/app.js?v=20261110-facturacion"></script>{% endblock %}
    </head>
    <body>
